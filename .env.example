# Copy to .env and edit. Never commit .env.
PORT=8765
STT_ENGINE=stub            # stub | google
TRANSLATE_ENGINE=stub      # stub | google
GOOGLE_CLOUD_PROJECT=      # project with Speech-to-Text + Translation enabled (google engines)
STT_LANGUAGE=en-US
TARGET_LANGUAGE=th
ZOOM_LANG=th-TH
ZOOM_MAX_CHARS=120
# ZOOM_CC_URL=             # optional; normally pasted on the control page
TRANSCRIPT_DIR=transcripts # EN/TH log; empty to disable
