# Copy to .env and edit. Never commit .env.
PORT=8765
# 127.0.0.1 = this machine only; 0.0.0.0 = other machines on the network can open /display
HOST=127.0.0.1

# Speech-to-text: stub | assemblyai | soniox | google  (soniox hears English and Thai; assemblyai English only)
STT_ENGINE=stub
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v6     # USD 0.12/h
MAX_LINE_CHARS=50          # soniox: start a new caption line after about this many characters (0 = only at pauses)
ASSEMBLYAI_API_KEY=
# AssemblyAI model (empty = AssemblyAI's default, which can change): assemblyai-stt-3-7-realtime-agent (USD 0.45/h,
# tested), assemblyai-stt-3-7-realtime (0.30/h), universal-streaming-english (legacy, 0.15/h)
STT_MODEL=assemblyai-stt-3-7-realtime-agent
STT_LANGUAGE=en-US

# Translation: stub | openrouter | google
TRANSLATE_ENGINE=stub
OPENROUTER_API_KEY=
TRANSLATE_MODEL=           # OpenRouter model id, see https://openrouter.ai/models
TARGET_LANGUAGE=th
SPEAKER_GENDER=            # male | female | empty: sets ครับ/ผม or ค่ะ/ดิฉัน in the Thai

# Google engines only
GOOGLE_CLOUD_PROJECT=

# Zoom captions
ZOOM_LANG=th-TH
ZOOM_MAX_CHARS=120
# ZOOM_CC_URL=             # optional; normally pasted on the control page

TRANSCRIPT_DIR=transcripts # EN/TH log; empty to disable
RECORD_DIR=recordings      # WAV of the room audio, one file per Start…Stop; empty to disable
